{
  "name": "@devmentor/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "migration:create": "mikro-orm migration:create",
    "migrate": "mikro-orm migration:up",
    "migrate:down": "mikro-orm migration:down"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@next/env": "^16.3.4",
    "tsx": "^4.23.15"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ],
    "preferTs": true,
    "tsLoader": "tsx"
  }
}
